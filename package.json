{
  "name": "hackerai-repeater",
  "displayName": "HackerAI Repeater",
  "description": "HTTP request builder and repeater — Burp Repeater inside VS Code",
  "version": "1.5.5",
  "publisher": "hackerai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": ["pentest", "http", "repeater", "burp", "hackerai"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "hackeraiPanel",
          "title": "HackerAI Repeater",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hackeraiPanel": [
        {
          "id": "hackeraiRepeater.view",
          "name": "Repeater",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "hackeraiRepeater.openRepeater",
        "title": "HackerAI: Open Repeater"
      },
      {
        "command": "hackeraiRepeater.sendToRepeater",
        "title": "HackerAI: Send Request to Repeater"
      }
    ],
    "keybindings": [
      {
        "command": "hackeraiRepeater.openRepeater",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hackeraiRepeater.sendToRepeater",
          "when": "editorHasSelection",
          "group": "hackerai"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xenos-hackcode/hackerai-repeater"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}